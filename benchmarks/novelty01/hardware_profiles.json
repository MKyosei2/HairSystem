{
  "schemaVersion": "novelty01-hardware-profile-v2",
  "profiles": {
    "low_gtx1660_reference": {
      "role": "primary_low_end_target",
      "description": "Primary lower-end reproducibility target for the formal Novelty01 suite.",
      "target": {
        "gpuNameRegex": "(GeForce )?GTX 1660( SUPER| Ti)?",
        "minimumDedicatedVramMiB": 5800,
        "maximumDedicatedVramMiB": 7000,
        "minimumCpuPhysicalCoreCount": 6,
        "maximumSystemRamMiB": 32768
      },
      "executionContract": {
        "acPowerRequired": true,
        "backgroundCaptureDisabled": true,
        "vsyncDisabled": true,
        "requiredWidth": 1920,
        "requiredHeight": 1080,
        "maximumGpuTemperatureCelsius": 88.0,
        "maximumGpuTemperatureSpreadCelsius": 12.0,
        "maximumGpuClockDropRatio": 0.15,
        "minimumGpuClockSamples": 3,
        "minimumGpuTimingCoverage": 0.99,
        "requiredPowerSchemeRegex": "(High performance|Ultimate Performance|高パフォーマンス|究極のパフォーマンス)"
      }
    },
    "development_any_hardware": {
      "role": "non_formal_development_only",
      "description": "Permissive profile for local debugging. Results must not be mixed with formal evidence.",
      "target": {},
      "executionContract": {
        "acPowerRequired": false,
        "vsyncDisabled": true,
        "requiredWidth": 1920,
        "requiredHeight": 1080,
        "minimumGpuTimingCoverage": 0.99
      }
    }
  }
}
