<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    HairGPU Step 0 complete profiling preflight.

    Default path is policy-safe: it does NOT launch HairSystem.exe, the native runner,
    PowerShell, or BAT. It uses only MSBuild built-in tasks so Visual Studio can always
    create timestamped profile_results even on Windows Application Control/AppLocker/WDAC
    locked-down machines.

    Real FPS measurement is still implemented in the viewer benchmark path and native
    runner files, but it requires the executable to be allowed by Windows policy.
  -->
  <PropertyGroup>
    <HairGpuStep0ProfileEnabled Condition="'$(HairGpuStep0ProfileEnabled)' == ''">false</HairGpuStep0ProfileEnabled>
    <HairGpuFormalBuild Condition="'$(HairGpuFormalBuild)' == ''">false</HairGpuFormalBuild>
    <HairGpuFormalSelfTest Condition="'$(HairGpuFormalSelfTest)' == ''">false</HairGpuFormalSelfTest>
    <HairGpuProfileRoot>$(MSBuildThisFileDirectory)profile_results</HairGpuProfileRoot>
    <HairGpuProfileTimestamp Condition="'$(HairGpuProfileTimestamp)' == ''">$([System.DateTime]::Now.ToString('yyyyMMdd_HHmmss'))</HairGpuProfileTimestamp>
    <HairGpuProfileTimestampHuman Condition="'$(HairGpuProfileTimestampHuman)' == ''">$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</HairGpuProfileTimestampHuman>
    <HairGpuStep0RunDir>$(HairGpuProfileRoot)\$(HairGpuProfileTimestamp)_STEP0_COMPLETE_POLICY_SAFE_$(MSBuildProjectName)_$(Configuration)_$(Platform)</HairGpuStep0RunDir>
    <HairGpuStep0WarmupFrames Condition="'$(HairGpuStep0WarmupFrames)' == ''">120</HairGpuStep0WarmupFrames>
    <HairGpuStep0MeasureFrames Condition="'$(HairGpuStep0MeasureFrames)' == ''">600</HairGpuStep0MeasureFrames>
    <HairGpuStep0TargetFps Condition="'$(HairGpuStep0TargetFps)' == ''">60</HairGpuStep0TargetFps>
    <HairGpuStep0TargetFrameMs Condition="'$(HairGpuStep0TargetFrameMs)' == ''">16.67</HairGpuStep0TargetFrameMs>
  </PropertyGroup>

  <ItemGroup>
    <HairGpuStep0Preset Include="00_current">
      <Description>Current default state. Baseline for the current 15 FPS class behavior.</Description>
      <Env>HAIRGPU_BENCHMARK=1;HAIRGPU_PROFILE_PRESET=00_current</Env>
      <ExpectedDiagnosis>Records the current frame time and does not disable any suspected bottleneck.</ExpectedDiagnosis>
    </HairGpuStep0Preset>
    <HairGpuStep0Preset Include="01_no_readback">
      <Description>Disable CPU/GPU readback and ActiveSet runtime readback paths.</Description>
      <Env>HAIRGPU_BENCHMARK=1;HAIRGPU_PROFILE_PRESET=01_no_readback;HAIRGPU_CPU_READBACK=off;HAIRGPU_ACTIVESET_RUNTIME=0</Env>
      <ExpectedDiagnosis>If this improves frame time, GPU to CPU synchronization/readback is a bottleneck.</ExpectedDiagnosis>
    </HairGpuStep0Preset>
    <HairGpuStep0Preset Include="02_no_self_collision">
      <Description>Disable self collision and grid self collision.</Description>
      <Env>HAIRGPU_BENCHMARK=1;HAIRGPU_PROFILE_PRESET=02_no_self_collision;HAIRGPU_SELF_COLLISION=0;HAIRGPU_GRID_SELF_COLLISION=0</Env>
      <ExpectedDiagnosis>If this improves frame time, self collision/broadphase/solve is a bottleneck.</ExpectedDiagnosis>
    </HairGpuStep0Preset>
    <HairGpuStep0Preset Include="03_low_solver">
      <Description>Use low solver iteration count.</Description>
      <Env>HAIRGPU_BENCHMARK=1;HAIRGPU_PROFILE_PRESET=03_low_solver;HAIRGPU_SOLVER_ITERATIONS=3</Env>
      <ExpectedDiagnosis>If this improves frame time, solver iteration count is a bottleneck.</ExpectedDiagnosis>
    </HairGpuStep0Preset>
    <HairGpuStep0Preset Include="04_no_debug_draw">
      <Description>Disable debug draw and debug overlays.</Description>
      <Env>HAIRGPU_BENCHMARK=1;HAIRGPU_PROFILE_PRESET=04_no_debug_draw;HAIRGPU_DEBUG_DRAW=0</Env>
      <ExpectedDiagnosis>If this improves frame time, debug rendering/overlay is a bottleneck.</ExpectedDiagnosis>
    </HairGpuStep0Preset>
    <HairGpuStep0Preset Include="05_render_light">
      <Description>Use lighter render mode and hide optional visual elements.</Description>
      <Env>HAIRGPU_BENCHMARK=1;HAIRGPU_PROFILE_PRESET=05_render_light;HAIRGPU_RENDER_MODE=billboard;HAIRGPU_SHOW_SCALP=0;HAIRGPU_FAST_VIEWPORT=1</Env>
      <ExpectedDiagnosis>If this improves frame time, hair draw/overdraw/render path is a bottleneck.</ExpectedDiagnosis>
    </HairGpuStep0Preset>
    <HairGpuStep0Preset Include="06_simulation_light">
      <Description>Minimal simulation stress: no readback, no self collision, low solver.</Description>
      <Env>HAIRGPU_BENCHMARK=1;HAIRGPU_PROFILE_PRESET=06_simulation_light;HAIRGPU_CPU_READBACK=off;HAIRGPU_ACTIVESET_RUNTIME=0;HAIRGPU_SELF_COLLISION=0;HAIRGPU_GRID_SELF_COLLISION=0;HAIRGPU_SOLVER_ITERATIONS=3</Env>
      <ExpectedDiagnosis>Lower-bound check for how much of the current cost is simulation side.</ExpectedDiagnosis>
    </HairGpuStep0Preset>
  </ItemGroup>

  <Target Name="HairGpuStep0CreateCompletePolicySafeProfile" AfterTargets="Build" Condition="'$(HairGpuStep0ProfileEnabled)' == 'true' and '$(HairGpuFormalBuild)' != 'true' and '$(TargetPath)' != ''">
    <MakeDir Directories="$(HairGpuProfileRoot)" />
    <MakeDir Directories="$(HairGpuStep0RunDir)" />
    <MakeDir Directories="@(HairGpuStep0Preset->'$(HairGpuStep0RunDir)\%(Identity)')" />

    <WriteLinesToFile File="$(HairGpuProfileRoot)\LATEST.txt" Overwrite="true" Encoding="UTF-8" Lines="$(HairGpuStep0RunDir);CreatedAt=$(HairGpuProfileTimestampHuman);Timestamp=$(HairGpuProfileTimestamp);Mode=STEP0_COMPLETE_POLICY_SAFE" />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\AUTO_PROFILE_STARTED.txt" Overwrite="true" Encoding="UTF-8" Lines="Step0Profile=COMPLETE_POLICY_SAFE;CreatedAt=$(HairGpuProfileTimestampHuman);Timestamp=$(HairGpuProfileTimestamp);Project=$(MSBuildProjectName);Configuration=$(Configuration);Platform=$(Platform);TargetPath=$(TargetPath);TargetDir=$(TargetDir);RunDir=$(HairGpuStep0RunDir);WarmupFrames=$(HairGpuStep0WarmupFrames);MeasureFrames=$(HairGpuStep0MeasureFrames);TargetFps=$(HairGpuStep0TargetFps);TargetFrameMs=$(HairGpuStep0TargetFrameMs);PowerShell=NOT_USED;BAT=NOT_USED;LocalExeExecution=NOT_USED_BY_DEFAULT;MSBuildTasks=MakeDir+WriteLinesToFile" />
    <WriteLinesToFile File="$(HairGpuProfileRoot)\PENDING_STEP0_REAL.ini" Overwrite="true" Encoding="UTF-8" Lines="enabled=1;runDir=$(HairGpuStep0RunDir);warmupFrames=$(HairGpuStep0WarmupFrames);measureFrames=$(HairGpuStep0MeasureFrames);presets=00_current,01_no_readback,02_no_self_collision,03_low_solver,04_no_debug_draw,05_render_light,06_simulation_light;createdAt=$(HairGpuProfileTimestampHuman);timestamp=$(HairGpuProfileTimestamp);targetPath=$(TargetPath);note=Launch HairSystem.exe normally after build. The viewer itself runs Step0 real measurement." />
    <MakeDir Directories="$(TargetDir)profile_results" />
    <WriteLinesToFile File="$(TargetDir)PENDING_STEP0_REAL.ini" Overwrite="true" Encoding="UTF-8" Lines="enabled=1;runDir=$(HairGpuStep0RunDir);warmupFrames=$(HairGpuStep0WarmupFrames);measureFrames=$(HairGpuStep0MeasureFrames);presets=00_current,01_no_readback,02_no_self_collision,03_low_solver,04_no_debug_draw,05_render_light,06_simulation_light;createdAt=$(HairGpuProfileTimestampHuman);timestamp=$(HairGpuProfileTimestamp);targetPath=$(TargetPath);note=duplicate pending file placed next to HairSystem.exe so startup detection cannot miss it." />
    <WriteLinesToFile File="$(TargetDir)profile_results\PENDING_STEP0_REAL.ini" Overwrite="true" Encoding="UTF-8" Lines="enabled=1;runDir=$(HairGpuStep0RunDir);warmupFrames=$(HairGpuStep0WarmupFrames);measureFrames=$(HairGpuStep0MeasureFrames);presets=00_current,01_no_readback,02_no_self_collision,03_low_solver,04_no_debug_draw,05_render_light,06_simulation_light;createdAt=$(HairGpuProfileTimestampHuman);timestamp=$(HairGpuProfileTimestamp);targetPath=$(TargetPath);note=duplicate pending file placed in TargetDir/profile_results for robust runtime discovery." />
    <WriteLinesToFile File="$(TargetDir)STEP0_REAL_MEASUREMENT_PENDING.txt" Overwrite="true" Encoding="UTF-8" Lines="Step0 real measurement is pending. Launch this HairSystem.exe normally after build. The application will detect PENDING_STEP0_REAL.ini and write RESULT_REAL.md to: $(HairGpuStep0RunDir)" />
    <WriteLinesToFile File="$(HairGpuProfileRoot)\STEP0_FORCE_RUN.ini" Overwrite="true" Encoding="UTF-8" Lines="enabled=1;runDir=$(HairGpuStep0RunDir);warmupFrames=$(HairGpuStep0WarmupFrames);measureFrames=$(HairGpuStep0MeasureFrames);presets=00_current,01_no_readback,02_no_self_collision,03_low_solver,04_no_debug_draw,05_render_light,06_simulation_light;createdAt=$(HairGpuProfileTimestampHuman);timestamp=$(HairGpuProfileTimestamp);targetPath=$(TargetPath);note=fallback force file: viewer can use this if PENDING_STEP0_REAL.ini is missing." />
    <WriteLinesToFile File="$(TargetDir)profile_results\STEP0_FORCE_RUN.ini" Overwrite="true" Encoding="UTF-8" Lines="enabled=1;runDir=$(HairGpuStep0RunDir);warmupFrames=$(HairGpuStep0WarmupFrames);measureFrames=$(HairGpuStep0MeasureFrames);presets=00_current,01_no_readback,02_no_self_collision,03_low_solver,04_no_debug_draw,05_render_light,06_simulation_light;createdAt=$(HairGpuProfileTimestampHuman);timestamp=$(HairGpuProfileTimestamp);targetPath=$(TargetPath);note=fallback force file next to exe." />
    <WriteLinesToFile File="$(TargetDir)STEP0_REAL_MEASUREMENT_READY.txt" Overwrite="true" Encoding="UTF-8" Lines="Step0 real measurement is armed.;Launch this executable normally: $(TargetPath);If the viewer starts, it must create STEP0_RUNTIME_BOOT.txt and then RESULT_REAL.md under: $(HairGpuStep0RunDir);If it does not, check STEP0_PENDING_SEARCH_LOG.txt next to the executable." />
    <WriteLinesToFile File="$(HairGpuStep0RunDir)\RUN_HAIRSYSTEM_FOR_REAL_MEASUREMENT.md" Overwrite="true" Encoding="UTF-8" Lines="# Run real Step 0 measurement; ;This build created `profile_results/PENDING_STEP0_REAL.ini`.; ;Next step: launch HairSystem.exe normally, not through a post-build runner.; ;When the viewer starts, it detects the pending file, runs all Step0 presets internally, writes real frames.csv/summary.json for each preset, then writes RESULT_REAL.md and RESULT_REAL.csv.; ;If Windows policy blocks HairSystem.exe itself, real measurement is impossible until the executable is allowed.; ;TargetPath: `$(TargetPath)`;RunDir: `$(HairGpuStep0RunDir)`;WarmupFrames: $(HairGpuStep0WarmupFrames);MeasureFrames: $(HairGpuStep0MeasureFrames)" />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\BUILD_CONDITION.txt" Overwrite="true" Encoding="UTF-8" Lines="CreatedAt=$(HairGpuProfileTimestampHuman);Project=$(MSBuildProjectName);Configuration=$(Configuration);Platform=$(Platform);TargetPath=$(TargetPath);OutDir=$(OutDir);TargetDir=$(TargetDir);MSBuildProjectFullPath=$(MSBuildProjectFullPath);VisualStudioVersion=$(VisualStudioVersion);MSBuildToolsVersion=$(MSBuildToolsVersion);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);TargetFps=$(HairGpuStep0TargetFps);TargetFrameMs=$(HairGpuStep0TargetFrameMs);WarmupFrames=$(HairGpuStep0WarmupFrames);MeasureFrames=$(HairGpuStep0MeasureFrames)" />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\PROFILE_SCHEMA.csv" Overwrite="true" Encoding="UTF-8" Lines="metric,meaning,source;avg_fps,Average FPS over measurement frames,viewer CSV when executable is allowed;avg_frame_ms,Average CPU frame time,viewer CSV when executable is allowed;p95_frame_ms,95th percentile frame time,viewer CSV analyzer;worst_frame_ms,Maximum frame time,viewer CSV analyzer;gpu_frame_ms,GPU total frame timing,viewer GPU timer;gpu_sim_ms,GPU simulation timing,viewer GPU timer;gpu_hair_ms,GPU hair draw timing,viewer GPU timer;active_set_ms,ActiveSet evaluation time,viewer telemetry;readback_particles,Number of particles read back to CPU,viewer telemetry;self_collision,Self collision enabled flag,viewer telemetry;solver_iterations,Simulation solver iteration count,viewer telemetry;hair_primitives,Drawn hair primitive count,viewer telemetry;status,policy-safe placeholder or measured,MSBuild/viewer" />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\PROFILE_MANIFEST.json" Overwrite="true" Encoding="UTF-8" Lines="{;&quot;profile_stage&quot;:&quot;step0_complete&quot;,;&quot;created_at&quot;:&quot;$(HairGpuProfileTimestampHuman)&quot;,;&quot;timestamp&quot;:&quot;$(HairGpuProfileTimestamp)&quot;,;&quot;mode&quot;:&quot;policy_safe_with_pending_real_measurement&quot;,;&quot;target_fps&quot;:$(HairGpuStep0TargetFps),;&quot;target_frame_ms&quot;:$(HairGpuStep0TargetFrameMs),;&quot;warmup_frames&quot;:$(HairGpuStep0WarmupFrames),;&quot;measure_frames&quot;:$(HairGpuStep0MeasureFrames),;&quot;viewer_execution&quot;:&quot;pending_until_user_launches_hairsystem&quot;,;&quot;real_fps_available&quot;:&quot;pending&quot;,;&quot;reason&quot;:&quot;Windows policy may block locally built executables; this build step intentionally uses MSBuild file tasks only.&quot;;}" />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\WINDOWS_POLICY_NOTE.txt" Overwrite="true" Encoding="UTF-8" Lines="CreatedAt=$(HairGpuProfileTimestampHuman);This folder was created without launching HairSystem.exe.;This avoids Application Control/AppLocker/WDAC blocking Visual Studio builds.;Real FPS measurement requires the executable to be allowed by Windows policy.;If you press F5 or Local Windows Debugger while the policy still blocks the EXE, Windows can show the application control dialog again." />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\REAL_MEASUREMENT_ENABLE_STEPS.md" Overwrite="true" Encoding="UTF-8" Lines="# Enabling real Step 0 FPS measurement; ;The policy-safe build step has created the full result structure. Actual FPS/GPU timings require HairSystem.exe to run.; ;## Required condition; ;Windows Application Control / AppLocker / WDAC must allow the built executable under `$(TargetPath)`.; ;## Environment used by the viewer benchmark path; ;`HAIRGPU_BENCHMARK=1`;`HAIRGPU_BENCHMARK_WARMUP=$(HairGpuStep0WarmupFrames)`;`HAIRGPU_BENCHMARK_FRAMES=$(HairGpuStep0MeasureFrames)`;`HAIRGPU_AUTO_TELEMETRY=1`;`HAIRGPU_TELEMETRY_DIR=&lt;preset_folder&gt;`;`HAIRGPU_TELEMETRY_RUN_NAME=&lt;preset_name&gt;`; ;## Presets; ;00_current, 01_no_readback, 02_no_self_collision, 03_low_solver, 04_no_debug_draw, 05_render_light, 06_simulation_light.; ;## Diagnosis thresholds; ;>= 5 ms improvement: suspicious;>= 10 ms improvement: strong bottleneck candidate;>= 20 ms improvement: primary bottleneck candidate." />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\RESULT.csv" Overwrite="true" Encoding="UTF-8" Lines="timestamp,preset,status,viewer_execution,real_fps_available,avg_fps,avg_frame_ms,p95_frame_ms,worst_frame_ms,diagnosis;$(HairGpuProfileTimestampHuman),00_current,created_policy_safe,skipped,no,,,,,baseline folder only;$(HairGpuProfileTimestampHuman),01_no_readback,created_policy_safe,skipped,no,,,,,compare against current after EXE is allowed;$(HairGpuProfileTimestampHuman),02_no_self_collision,created_policy_safe,skipped,no,,,,,compare against current after EXE is allowed;$(HairGpuProfileTimestampHuman),03_low_solver,created_policy_safe,skipped,no,,,,,compare against current after EXE is allowed;$(HairGpuProfileTimestampHuman),04_no_debug_draw,created_policy_safe,skipped,no,,,,,compare against current after EXE is allowed;$(HairGpuProfileTimestampHuman),05_render_light,created_policy_safe,skipped,no,,,,,compare against current after EXE is allowed;$(HairGpuProfileTimestampHuman),06_simulation_light,created_policy_safe,skipped,no,,,,,compare against current after EXE is allowed" />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\RESULT.md" Overwrite="true" Encoding="UTF-8" Lines="# HairGPU Step 0 Complete Profile / Lightweight Setting Check; ;CreatedAt: $(HairGpuProfileTimestampHuman);Timestamp: $(HairGpuProfileTimestamp);RunDir: $(HairGpuStep0RunDir);Project: $(MSBuildProjectName);Configuration: $(Configuration);Platform: $(Platform);Target: $(TargetPath); ;## Status; ;profile_results creation: PASS;preset directories creation: PASS;Visual Studio/MSBuild hook: PASS;PowerShell: NOT_USED;BAT: NOT_USED;Local EXE execution during build: NOT_USED_BY_DEFAULT;Real measurement trigger files: WRITTEN_TO_REPO_AND_TARGETDIR;real FPS measurement: PENDING_UNTIL_HAIRSYSTEM_EXE_IS_LAUNCHED_AND_ALLOWED;pending file: profile_results/PENDING_STEP0_REAL.ini and $(TargetDir)PENDING_STEP0_REAL.ini; ;## What is fully implemented; ;The repository now has the full Step 0 folder structure, preset matrix, telemetry schema, benchmark environment contract, and policy-safe Visual Studio build hook. The viewer-side benchmark path exports frame CSV and runtime JSON when the executable is allowed to run. This build also writes PENDING_STEP0_REAL.ini, STEP0_FORCE_RUN.ini, and target-dir fallback files so startup detection does not silently fail.; ;## Why this file is not the real result; ;This RESULT.md is build-only preflight. It is NOT the Step0 measurement result. The real result is RESULT_REAL.md, which appears only after HairSystem.exe starts and completes the embedded benchmark. If it does not appear after launching HairSystem.exe, inspect STEP0_PENDING_SEARCH_LOG.txt next to the executable. If HairSystem.exe is blocked by Windows policy, true FPS measurement is impossible until the executable is allowed.; ;## Presets; ;| Preset | Purpose | Diagnosis after real run |;|---|---|---|;| 00_current | Current settings | Baseline |;| 01_no_readback | Disable readback / ActiveSet runtime | Improvement means readback or CPU/GPU sync is heavy |;| 02_no_self_collision | Disable self collision | Improvement means self collision or broadphase is heavy |;| 03_low_solver | solverIterations=3 | Improvement means solver iteration cost is heavy |;| 04_no_debug_draw | Disable debug draw | Improvement means debug visualization is heavy |;| 05_render_light | Lighter render settings | Improvement means draw/overdraw/hair rendering is heavy |;| 06_simulation_light | No readback, no self collision, low solver | Lower bound for simulation-light condition |; ;## Diagnosis thresholds after real run; ;>= 5 ms improvement: suspicious;>= 10 ms improvement: strong bottleneck candidate;>= 20 ms improvement: primary bottleneck candidate; ;## Next research step; ;Once real execution is allowed, compare 00_current to the six presets and use the largest frame-time reduction to decide whether Step 1 should prioritize readback removal, self-collision gating, solver budget control, or rendering LOD." />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\%(HairGpuStep0Preset.Identity)\RUN_STARTED.txt" Overwrite="true" Encoding="UTF-8" Lines="preset=%(HairGpuStep0Preset.Identity);description=%(HairGpuStep0Preset.Description);CreatedAt=$(HairGpuProfileTimestampHuman);Timestamp=$(HairGpuProfileTimestamp);status=created_without_launching_viewer;reason=policy_safe_step0_complete" />
    <WriteLinesToFile File="$(HairGpuStep0RunDir)\%(HairGpuStep0Preset.Identity)\env.txt" Overwrite="true" Encoding="UTF-8" Lines="%(HairGpuStep0Preset.Env);HAIRGPU_BENCHMARK_WARMUP=$(HairGpuStep0WarmupFrames);HAIRGPU_BENCHMARK_FRAMES=$(HairGpuStep0MeasureFrames);HAIRGPU_AUTO_TELEMETRY=1;HAIRGPU_TELEMETRY_DIR=$(HairGpuStep0RunDir)\%(HairGpuStep0Preset.Identity);HAIRGPU_TELEMETRY_RUN_NAME=%(HairGpuStep0Preset.Identity)" />
    <WriteLinesToFile File="$(HairGpuStep0RunDir)\%(HairGpuStep0Preset.Identity)\process_status.txt" Overwrite="true" Encoding="UTF-8" Lines="status=not_executed_by_policy_safe_build;viewer_execution=skipped_by_default;real_fps_available=no;expected_diagnosis=%(HairGpuStep0Preset.ExpectedDiagnosis);target=$(TargetPath)" />
    <WriteLinesToFile File="$(HairGpuStep0RunDir)\%(HairGpuStep0Preset.Identity)\%(HairGpuStep0Preset.Identity)_frames.csv" Overwrite="true" Encoding="UTF-8" Lines="sampleIndex,elapsedSeconds,frameMilliseconds,simulationMilliseconds,gpuFrameMilliseconds,gpuSimulationMilliseconds,gpuHairDrawMilliseconds,gpuDebugDrawMilliseconds,fps,guideCount,followerCount,totalStrandCount,totalParticleCount,activeSetEvaluationMilliseconds,solverIterations,selfCollisionEnabled,gridSelfCollisionEnabled,cpuReadbackMode,readbackParticleCount,hairPrimitiveCount,hairPsInvocations,debugPsInvocations,status" />
    <WriteLinesToFile File="$(HairGpuStep0RunDir)\%(HairGpuStep0Preset.Identity)\%(HairGpuStep0Preset.Identity)_summary.json" Overwrite="true" Encoding="UTF-8" Lines="{;&quot;preset&quot;:&quot;%(HairGpuStep0Preset.Identity)&quot;,;&quot;description&quot;:&quot;%(HairGpuStep0Preset.Description)&quot;,;&quot;status&quot;:&quot;not_executed_by_policy_safe_build&quot;,;&quot;real_fps_available&quot;:&quot;pending&quot;,;&quot;expected_diagnosis&quot;:&quot;%(HairGpuStep0Preset.ExpectedDiagnosis)&quot;;}" />
    <WriteLinesToFile File="$(HairGpuStep0RunDir)\%(HairGpuStep0Preset.Identity)\EXPECTED_DIAGNOSIS.txt" Overwrite="true" Encoding="UTF-8" Lines="%(HairGpuStep0Preset.ExpectedDiagnosis)" />

    <WriteLinesToFile File="$(HairGpuStep0RunDir)\EXE_BLOCKED_BY_WINDOWS_POLICY.md" Overwrite="true" Encoding="UTF-8" Lines="# HairSystem.exe may be blocked by Windows policy; ;If Visual Studio shows application control policy blocked this file, the executable did not start.; ;In that state, Step0 real measurement is impossible because no frame is rendered and no GPU timing is collected.; ;Valid Step0 output requires RESULT_REAL.md and RESULT_REAL.csv. This build-only folder is not a real measurement.; ;Allow this executable path, then launch HairSystem.exe normally: $(TargetPath); ;Expected real-output files after successful launch: RESULT_REAL.md, RESULT_REAL.csv, and preset *_frames.csv files with frame rows." />
    <WriteLinesToFile File="$(TargetDir)EXE_BLOCKED_BY_WINDOWS_POLICY.md" Overwrite="true" Encoding="UTF-8" Lines="# HairSystem.exe blocked by policy means Step0 cannot measure; ;This file is placed next to the executable so it is easy to find.; ;If Windows blocks this EXE before it starts, project code cannot write RESULT_REAL.md.; ;Ask the administrator to allow: $(TargetPath); ;After allowing the EXE, run HairSystem.exe again and check profile_results for RESULT_REAL.md." />

    <Message Importance="high" Text="[HairGPU Step0] Complete policy-safe profile_results created at: $(HairGpuStep0RunDir)" />
    <Message Importance="high" Text="[HairGPU Step0] CreatedAt: $(HairGpuProfileTimestampHuman)" />
    <Message Importance="high" Text="[HairGPU Step0] Real FPS requires HairSystem.exe to be allowed by Windows policy." />
  </Target>
</Project>
