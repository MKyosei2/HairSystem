set(_ALEMBIC_HINTS
    ${ALEMBIC_ROOT}
    $ENV{ALEMBIC_ROOT}
    $ENV{ALEMBIC_DIR}
    $ENV{ALEMBIC_HOME}
)

find_path(ALEMBIC_INCLUDE_DIR
    NAMES Alembic/AbcGeom/All.h
    HINTS ${_ALEMBIC_HINTS}
    PATH_SUFFIXES include Include
)

find_library(ALEMBIC_ABC_LIBRARY NAMES Alembic Abc HINTS ${_ALEMBIC_HINTS} PATH_SUFFIXES lib lib64)
find_library(ALEMBIC_ABCGEOM_LIBRARY NAMES AlembicAbcGeom AbcGeom HINTS ${_ALEMBIC_HINTS} PATH_SUFFIXES lib lib64)
find_library(ALEMBIC_ABC_CORE_HDF5_LIBRARY NAMES AlembicAbcCoreHDF5 AbcCoreHDF5 HINTS ${_ALEMBIC_HINTS} PATH_SUFFIXES lib lib64)
find_library(ALEMBIC_ABC_CORE_OGAWA_LIBRARY NAMES AlembicAbcCoreOgawa AbcCoreOgawa HINTS ${_ALEMBIC_HINTS} PATH_SUFFIXES lib lib64)
find_library(ALEMBIC_UTIL_LIBRARY NAMES AlembicUtil Util HINTS ${_ALEMBIC_HINTS} PATH_SUFFIXES lib lib64)
find_library(ALEMBIC_IEX_LIBRARY NAMES Iex IlmThread Imath Half HINTS ${_ALEMBIC_HINTS} PATH_SUFFIXES lib lib64)

include(FindPackageHandleStandardArgs)
set(ALEMBIC_LIBRARIES
    ${ALEMBIC_ABC_LIBRARY}
    ${ALEMBIC_ABCGEOM_LIBRARY}
    ${ALEMBIC_ABC_CORE_HDF5_LIBRARY}
    ${ALEMBIC_ABC_CORE_OGAWA_LIBRARY}
    ${ALEMBIC_UTIL_LIBRARY}
    ${ALEMBIC_IEX_LIBRARY}
)
list(REMOVE_DUPLICATES ALEMBIC_LIBRARIES)
set(ALEMBIC_INCLUDE_DIRS ${ALEMBIC_INCLUDE_DIR})

find_package_handle_standard_args(Alembic DEFAULT_MSG ALEMBIC_INCLUDE_DIR ALEMBIC_ABC_LIBRARY)
if(ALEMBIC_FOUND AND NOT TARGET Alembic::Alembic)
    add_library(Alembic::Alembic INTERFACE IMPORTED)
    set_target_properties(Alembic::Alembic PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${ALEMBIC_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES "${ALEMBIC_LIBRARIES}"
    )
endif()
mark_as_advanced(ALEMBIC_INCLUDE_DIR ALEMBIC_ABC_LIBRARY ALEMBIC_ABCGEOM_LIBRARY ALEMBIC_ABC_CORE_HDF5_LIBRARY ALEMBIC_ABC_CORE_OGAWA_LIBRARY ALEMBIC_UTIL_LIBRARY ALEMBIC_IEX_LIBRARY)
