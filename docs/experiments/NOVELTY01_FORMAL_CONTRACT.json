    "applicationControlExecutionProbeRequired": true,
    "nativeAndShaderSelfTestsRequiredBeforeAssetFreeze": true,
    "securityPolicyBypassForbidden": true
  },
  "signingPolicy": {
    "schema": "hairgpu-formal-signing-policy-v1",
    "required": true,
    "certificateSubjectLike": "HairSystem Internal Test Signing",
    "defaultStoreScope": "CurrentUser",
    "signatureStatusRequired": "Valid",
    "signBeforeViewerHash": true,
    "actualCreateProcessProbeRequired": true,
    "requiredViewerProbes": [
      "--native-self-test",
      "--shader-self-test"
    ],
    "winError4551Policy": "fail-closed-with-diagnostic; do-not-disable-or-bypass-app-control"
  }
