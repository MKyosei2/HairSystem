# HairGPU policy-safe profile result creator.
# Executed by CMake/MSBuild after a successful Visual Studio build.
# It does not run the freshly built viewer by default, because strict Windows
# Application Control/AppLocker/WDAC can block unsigned local EXE files.

if(NOT DEFINED HAIRGPU_REPO_ROOT)
    get_filename_component(HAIRGPU_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
if(NOT DEFINED HAIRGPU_CONFIG)
    set(HAIRGPU_CONFIG "UnknownConfig")
endif()
if(NOT DEFINED HAIRGPU_PLATFORM)
    set(HAIRGPU_PLATFORM "Windows")
endif()
if(NOT DEFINED HAIRGPU_TARGET_FILE)
    set(HAIRGPU_TARGET_FILE "")
endif()

string(TIMESTAMP HAIRGPU_STAMP "%Y%m%d_%H%M%S")
set(HAIRGPU_RESULTS_ROOT "${HAIRGPU_REPO_ROOT}/profile_results")
set(HAIRGPU_RUN_NAME "${HAIRGPU_STAMP}_${HAIRGPU_CONFIG}_${HAIRGPU_PLATFORM}_policy_safe")
set(HAIRGPU_RUN_DIR "${HAIRGPU_RESULTS_ROOT}/${HAIRGPU_RUN_NAME}")

file(MAKE_DIRECTORY "${HAIRGPU_RESULTS_ROOT}")
file(MAKE_DIRECTORY "${HAIRGPU_RUN_DIR}")
file(WRITE "${HAIRGPU_RESULTS_ROOT}/LATEST.txt" "${HAIRGPU_RUN_DIR}\n")
file(WRITE "${HAIRGPU_RUN_DIR}/AUTO_PROFILE_STARTED.txt" "HairGPU policy-safe auto profile result was created by CMake/MSBuild.\n")
file(APPEND "${HAIRGPU_RUN_DIR}/AUTO_PROFILE_STARTED.txt" "Timestamp: ${HAIRGPU_STAMP}\n")
file(APPEND "${HAIRGPU_RUN_DIR}/AUTO_PROFILE_STARTED.txt" "Configuration: ${HAIRGPU_CONFIG}\n")
file(APPEND "${HAIRGPU_RUN_DIR}/AUTO_PROFILE_STARTED.txt" "Platform: ${HAIRGPU_PLATFORM}\n")
file(APPEND "${HAIRGPU_RUN_DIR}/AUTO_PROFILE_STARTED.txt" "Target: ${HAIRGPU_TARGET_FILE}\n")

set(HAIRGPU_PRESETS 00_current 01_no_readback 02_no_self_collision 03_low_solver 04_no_debug_draw 05_render_light)
foreach(PRESET IN LISTS HAIRGPU_PRESETS)
    set(PRESET_DIR "${HAIRGPU_RUN_DIR}/${PRESET}")
    file(MAKE_DIRECTORY "${PRESET_DIR}")
    file(WRITE "${PRESET_DIR}/RUN_STARTED.txt" "Preset ${PRESET} was initialized.\n")
    file(WRITE "${PRESET_DIR}/process_status.txt" "NOT_EXECUTED_BY_DEFAULT\nReason: Windows Application Control/AppLocker/WDAC may block locally built EXE files.\nThis policy-safe build step creates profile_results without launching the viewer.\n")
    file(WRITE "${PRESET_DIR}/env.txt" "HAIRGPU_BENCHMARK=1\nHAIRGPU_PRESET=${PRESET}\nHAIRGPU_TARGET_FILE=${HAIRGPU_TARGET_FILE}\n")
    file(WRITE "${PRESET_DIR}/${PRESET}_summary.json" "{\n  \"preset\": \"${PRESET}\",\n  \"status\": \"not_executed_by_policy_safe_mode\",\n  \"reason\": \"The viewer executable was not launched so Windows Application Control cannot block the build step.\",\n  \"target\": \"${HAIRGPU_TARGET_FILE}\"\n}\n")
    file(WRITE "${PRESET_DIR}/${PRESET}_frames.csv" "frame,frameMilliseconds,fps,gpuFrameMilliseconds,gpuSimulationMilliseconds,gpuHairDrawMilliseconds,activeSetEvaluationMilliseconds,status\n")
endforeach()

file(WRITE "${HAIRGPU_RUN_DIR}/RESULT.csv" "preset,status,avg_fps,avg_frame_ms,p95_frame_ms,worst_frame_ms,diagnosis\n")
foreach(PRESET IN LISTS HAIRGPU_PRESETS)
    file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.csv" "${PRESET},not_executed_by_policy_safe_mode,,,,,Viewer execution intentionally skipped to avoid Application Control blocking\n")
endforeach()

file(WRITE "${HAIRGPU_RUN_DIR}/RESULT.md" "# HairGPU Auto Profile Result - Policy Safe Mode\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "This folder was created by Visual Studio/MSBuild through CMake without launching the newly built HairSystem executable.\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "## Why this mode exists\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "Windows Application Control, AppLocker, or WDAC can block locally built EXE files. If the viewer is launched during Post-Build or by the debugger, Visual Studio may show: `Application Control policy blocked this file`. This policy-safe mode avoids that by not executing the viewer during build.\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "## Status\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "- profile_results creation: PASS\n- preset directories creation: PASS\n- viewer execution: SKIPPED_BY_DEFAULT\n- real FPS measurement: NOT_AVAILABLE_UNTIL_VIEWER_EXECUTION_IS_ALLOWED\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "## Build information\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "- Configuration: `${HAIRGPU_CONFIG}`\n- Platform: `${HAIRGPU_PLATFORM}`\n- Target: `${HAIRGPU_TARGET_FILE}`\n- Run directory: `${HAIRGPU_RUN_DIR}`\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "## How to get real FPS measurements\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "Real FPS data requires the HairSystem executable to run. If Windows policy blocks it, the code cannot measure rendering or simulation time. Use one of the following safe options: ask the administrator to allow this repository/bin path, build in a trusted workspace, or sign the executable with a certificate trusted by the local policy. After that, run the viewer with `HAIRGPU_BENCHMARK=1`.\n\n")
file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "## Presets initialized\n\n")
foreach(PRESET IN LISTS HAIRGPU_PRESETS)
    file(APPEND "${HAIRGPU_RUN_DIR}/RESULT.md" "- `${PRESET}`\n")
endforeach()

file(WRITE "${HAIRGPU_RUN_DIR}/WINDOWS_POLICY_NOTE.txt" "The real viewer executable was not launched. This is intentional. It prevents Windows Application Control from blocking the Visual Studio build step. If you need actual FPS values, the executable must be allowed by Windows policy first.\n")
message(STATUS "HairGPU policy-safe profile_results created: ${HAIRGPU_RUN_DIR}")
