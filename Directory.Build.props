<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Intentionally contains no source-generating BeforeTargets hooks.
       Formal builds must compile the checked-in source tree exactly as-is. -->
  <PropertyGroup>
    <HairGpuSourceGenerationDuringBuild>false</HairGpuSourceGenerationDuringBuild>
  </PropertyGroup>
</Project>
