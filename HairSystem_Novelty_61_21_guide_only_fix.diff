@@
-                    compactedGuidePointCount += m_asset.strands[guideIndex].pointCount;
+                    const uint32_t pointCount = m_asset.strands[guideIndex].pointCount;
+                    // Compacted guide-point dispatch in HairSim.hlsl excludes roots.
+                    compactedGuidePointCount += (pointCount > 1u) ? (pointCount - 1u) : 0u;
diff --git a/apps/dx11_viewer/src/GpuHairViewer_parts/01_window_device_and_ui_setup.inl b/apps/dx11_viewer/src/GpuHairViewer_parts/01_window_device_and_ui_setup.inl
--- a/apps/dx11_viewer/src/GpuHairViewer_parts/01_window_device_and_ui_setup.inl
+++ b/apps/dx11_viewer/src/GpuHairViewer_parts/01_window_device_and_ui_setup.inl
@@
         UINT DispatchGroups(UINT itemCount, UINT groupSize)
         {
-            return (itemCount + groupSize - 1u) / groupSize;
+            if (itemCount == 0u || groupSize == 0u)
+            {
+                return 0u;
+            }
+
+            const uint64_t groups =
+                (static_cast<uint64_t>(itemCount) + static_cast<uint64_t>(groupSize) - 1ull) /
+                static_cast<uint64_t>(groupSize);
+
+            if (groups > D3D11_CS_DISPATCH_MAX_THREAD_GROUPS_PER_DIMENSION)
+            {
+                OutputDebugStringA(
+                    "HairSystem: DispatchGroups exceeded the D3D11 per-dimension limit. "
+                    "Use guide-only, active-set, indirect, 2D, or chunked dispatch for this pass.\n");
+                return 0u;
+            }
+
+            return static_cast<UINT>(groups);
         }
